<Window x:Class="Bloop.Desktop.Windows.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bloop — Notification Inbox &amp; Companion Panel"
        Width="376"
        Height="500"
        MinWidth="328"
        MinHeight="370"
        WindowStyle="None"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        SizeChanged="OnWindowSizeChanged">
    <WindowChrome.WindowChrome>
        <WindowChrome x:Name="PanelWindowChrome"
                      GlassFrameThickness="-1"
                      ResizeBorderThickness="0"
                      CaptionHeight="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- Level 1: Main Liquid Glass Panel Surface -->
    <Border x:Name="OuterPanelBorder"
            CornerRadius="{DynamicResource GlassWindowCornerRadius}"
            Background="{DynamicResource GlassLevel1FillBrush}"
            BorderBrush="{DynamicResource GlassLevel1RimBrush}"
            BorderThickness="1"
            ClipToBounds="True">
        <Grid>
            <!-- Ambient top-left glass refraction glow -->
            <Border Background="{DynamicResource GlassLevel1AmbientGlowBrush}"
                    IsHitTestVisible="False" />

            <!-- 1px top specular catch-light edge -->
            <Border Height="1"
                    VerticalAlignment="Top"
                    Margin="14,0,14,0"
                    Background="{DynamicResource GlassLevel1TopSpecularBrush}"
                    IsHitTestVisible="False" />

            <Grid Margin="14,12,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Row 0: Header Bar (Draggable in Detached Mode) -->
                <Border Grid.Row="0"
                        Background="Transparent"
                        MouseLeftButtonDown="OnHeaderMouseLeftButtonDown"
                        Cursor="SizeAll"
                        Margin="0,0,0,10">
                    <DockPanel LastChildFill="False">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8"
                                     Height="8"
                                     Fill="{DynamicResource GlassPrimaryAccentFillBrush}"
                                     Margin="0,0,7,0"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="HeaderTitleText"
                                       Text="Bloop Inbox"
                                       Foreground="{DynamicResource GlassPrimaryTextBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="13.5"
                                       VerticalAlignment="Center" />
                            <Border x:Name="HeaderUnreadPill"
                                    Background="#D8E11D48"
                                    BorderBrush="#88FDA4AF"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="6,1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="HeaderUnreadText"
                                           Text="0"
                                           Foreground="White"
                                           FontSize="10"
                                           FontWeight="Bold" />
                            </Border>
                        </StackPanel>

                        <Button Content="✕"
                                DockPanel.Dock="Right"
                                Style="{StaticResource GlassIconButtonStyle}"
                                Click="OnCloseClick"
                                FontSize="12"
                                Padding="7,2" />

                        <Button x:Name="AttachDetachButton"
                                Content="Detach ↗"
                                DockPanel.Dock="Right"
                                Style="{StaticResource GlassSecondaryButtonStyle}"
                                Click="OnAttachDetachClick"
                                FontSize="10.5"
                                Padding="8,2.5"
                                Margin="0,0,6,0" />
                    </DockPanel>
                </Border>

                <!-- Row 1: Mode Switcher Segmented Glass Bar -->
                <Border Grid.Row="1"
                        Background="{DynamicResource GlassLevel2FillBrush}"
                        BorderBrush="{DynamicResource GlassLevel2BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="3"
                        Margin="0,0,0,10">
                    <UniformGrid Columns="3">
                        <Button x:Name="InboxTabButton"
                                Content="Inbox"
                                Style="{StaticResource GlassPrimaryButtonStyle}"
                                Click="OnShowInboxTabClick"
                                Padding="6,4.5"
                                Margin="0,0,2,0"
                                FontSize="11" />
                        <Button x:Name="WorkspaceTabButton"
                                Content="Workspace"
                                Style="{StaticResource GlassSecondaryButtonStyle}"
                                Click="OnShowWorkspaceTabClick"
                                Padding="6,4.5"
                                Margin="1,0,1,0"
                                FontSize="11" />
                        <Button x:Name="CompanionTabButton"
                                Content="Companion"
                                Style="{StaticResource GlassSecondaryButtonStyle}"
                                Click="OnShowCompanionTabClick"
                                Padding="6,4.5"
                                Margin="2,0,0,0"
                                FontSize="11" />
                    </UniformGrid>
                </Border>

                <!-- Row 2A: Notification Inbox View -->
                <Grid x:Name="InboxViewGrid" Grid.Row="2" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Permission / Opt-In State Banner -->
                    <Border x:Name="PermissionBanner"
                            Grid.Row="0"
                            Style="{StaticResource GlassSectionBorderStyle}"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="PermissionBannerTitle"
                                       Text="Enable Windows Notification Inbox (Opt-In)"
                                       Foreground="{DynamicResource GlassAccentTextBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Margin="0,0,0,4" />
                            <TextBlock x:Name="PermissionBannerBody"
                                       Text="Bloop reads notification titles and messages locally on your PC to show your grouped inbox and animate. Message contents are never logged or sent externally."
                                       Foreground="{DynamicResource GlassSecondaryTextBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8" />
                            <Button x:Name="EnableNotificationsButton"
                                    Content="Enable &amp; Grant Access"
                                    Style="{StaticResource GlassPrimaryButtonStyle}"
                                    Click="OnEnableNotificationsClick"
                                    Padding="10,5"
                                    HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <!-- Inbox Action Toolbar -->
                    <DockPanel x:Name="InboxToolbar"
                               Grid.Row="1"
                               LastChildFill="False"
                               Margin="0,0,0,8">
                        <Button Content="Sync"
                                Style="{StaticResource GlassSecondaryButtonStyle}"
                                Click="OnSyncNowClick"
                                Padding="8,3.5"
                                Margin="0,0,5,0"
                                FontSize="10.5" />
                        <Button Content="Mark All Read"
                                Style="{StaticResource GlassSecondaryButtonStyle}"
                                Click="OnMarkAllReadClick"
                                Padding="8,3.5"
                                Margin="0,0,5,0"
                                FontSize="10.5" />
                        <Button Content="Clear Local"
                                DockPanel.Dock="Right"
                                Style="{StaticResource GlassDangerButtonStyle}"
                                Click="OnClearLocalHistoryClick"
                                Padding="8,3.5"
                                FontSize="10.5" />
                    </DockPanel>

                    <!-- Empty State (Level 2 Frosted Surface) -->
                    <Border x:Name="EmptyInboxState"
                            Grid.Row="2"
                            Background="{DynamicResource GlassLevel2FillBrush}"
                            BorderBrush="{DynamicResource GlassLevel2BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource GlassSectionCornerRadius}"
                            Padding="18"
                            Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="All caught up!"
                                       Foreground="{DynamicResource GlassAccentTextBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="No active notifications in your local inbox."
                                       Foreground="{DynamicResource GlassMutedTextBrush}"
                                       FontSize="11"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Grouped Notifications Scroll List -->
                    <ScrollViewer x:Name="NotificationsScrollViewer"
                                  Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="NotificationGroupsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Level 2: Application Group Container -->
                                    <Border Background="{Binding GroupBackgroundBrush}"
                                            BorderBrush="{Binding GroupBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{Binding GroupCornerRadius}"
                                            Padding="{Binding GroupPadding}"
                                            Margin="0,0,0,9">
                                        <StackPanel>
                                            <!-- Application Group Header -->
                                            <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                                <Border Width="22"
                                                        Height="22"
                                                        CornerRadius="6"
                                                        Background="{Binding AccentBrush}"
                                                        BorderBrush="#55FFFFFF"
                                                        BorderThickness="0.8"
                                                        Margin="0,0,7,0"
                                                        VerticalAlignment="Center">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Monogram}"
                                                                   Foreground="White"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                        <Image Source="{Binding IconImage}"
                                                               Width="18"
                                                               Height="18"
                                                               Stretch="Uniform" />
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="{Binding HeaderTitle}"
                                                           Foreground="{Binding GroupTitleBrush}"
                                                           FontWeight="SemiBold"
                                                           FontSize="11.5"
                                                           VerticalAlignment="Center" />
                                                <Button Content="Hide App"
                                                        Tag="{Binding AppUserModelId}"
                                                        DockPanel.Dock="Right"
                                                        Style="{StaticResource GlassIconButtonStyle}"
                                                        Click="OnDismissGroupClick"
                                                        Foreground="{DynamicResource GlassMutedTextBrush}"
                                                        FontSize="10"
                                                        Padding="6,2" />
                                            </DockPanel>

                                            <!-- Level 3: Layered Notification Cards within Group -->
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding CardBackgroundBrush}"
                                                                BorderBrush="{Binding CardBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="{Binding CardCornerRadius}"
                                                                Margin="{Binding CardMargin}"
                                                                ClipToBounds="True">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Left-edge luminous accent bar for Unread / High Priority -->
                                                                <Border Grid.Column="0"
                                                                        Width="3"
                                                                        Background="{Binding LeftAccentBarBrush}"
                                                                        Visibility="{Binding LeftAccentBarVisibility}" />

                                                                <StackPanel Grid.Column="1" Margin="{Binding CardPadding}">
                                                                    <DockPanel LastChildFill="False" Margin="0,0,0,3">
                                                                        <Ellipse Width="6.5"
                                                                                 Height="6.5"
                                                                                 Fill="{Binding AccentBrush}"
                                                                                 Margin="0,0,5,0"
                                                                                 VerticalAlignment="Center"
                                                                                 Visibility="{Binding UnreadDotVisibility}" />
                                                                        <Border Background="#38F43F5E"
                                                                                BorderBrush="#77FB7185"
                                                                                BorderThickness="0.8"
                                                                                CornerRadius="4"
                                                                                Padding="4,0.5"
                                                                                Margin="0,0,6,0"
                                                                                VerticalAlignment="Center"
                                                                                Visibility="{Binding ImportanceBadgeVisibility}">
                                                                            <TextBlock Text="{Binding ImportanceBadge}"
                                                                                       Foreground="#FDA4AF"
                                                                                       FontWeight="Bold"
                                                                                       FontSize="8.8" />
                                                                        </Border>
                                                                        <TextBlock Text="{Binding TimestampText}"
                                                                                   Foreground="{DynamicResource GlassMutedTextBrush}"
                                                                                   FontSize="10"
                                                                                   VerticalAlignment="Center" />
                                                                        <TextBlock Text="• Active"
                                                                                   Foreground="{Binding AccentBrush}"
                                                                                   FontSize="9.5"
                                                                                   Margin="5,0,0,0"
                                                                                   VerticalAlignment="Center"
                                                                                   Visibility="{Binding PresentInOsVisibility}" />
                                                                    </DockPanel>

                                                                    <TextBlock Text="{Binding Title}"
                                                                               Foreground="{Binding TitleForeground}"
                                                                               FontWeight="{Binding TitleFontWeight}"
                                                                               FontSize="11.5"
                                                                               TextWrapping="Wrap"
                                                                               Margin="0,0,0,2" />

                                                                    <TextBlock Text="{Binding Body}"
                                                                               Foreground="{Binding BodyForeground}"
                                                                               FontSize="11"
                                                                               TextWrapping="Wrap"
                                                                               Visibility="{Binding BodyVisibility}"
                                                                               Margin="0,0,0,6" />

                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                                        <Button Content="{Binding ToggleReadLabel}"
                                                                                Tag="{Binding Id}"
                                                                                Style="{StaticResource GlassSecondaryButtonStyle}"
                                                                                Click="OnToggleReadClick"
                                                                                FontSize="9.8"
                                                                                Padding="6,2"
                                                                                Margin="0,0,4,0" />
                                                                        <Button Content="Hide"
                                                                                Tag="{Binding Id}"
                                                                                Style="{StaticResource GlassSecondaryButtonStyle}"
                                                                                Click="OnDismissLocallyClick"
                                                                                FontSize="9.8"
                                                                                Padding="6,2"
                                                                                Margin="0,0,4,0" />
                                                                        <Button Content="Clear OS"
                                                                                Tag="{Binding}"
                                                                                Style="{StaticResource GlassPrimaryButtonStyle}"
                                                                                Click="OnDismissOsClick"
                                                                                Visibility="{Binding PresentInOsVisibility}"
                                                                                FontSize="9.8"
                                                                                Padding="6,2" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Row 2B: Milestone 7 Productivity Workspace (Launcher, Tasks/Timers/Reminders, Quick Notes) -->
                <Grid x:Name="WorkspaceViewGrid" Grid.Row="2" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Sub-Mode Selector -->
                    <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,8">
                        <Button x:Name="SubLauncherButton"
                                Content="Launcher"
                                Style="{StaticResource GlassPrimaryButtonStyle}"
                                Click="OnShowLauncherSubTabClick"
                                Padding="5,3.5"
                                Margin="0,0,2,0"
                                FontSize="10.5" />
                        <Button x:Name="SubTasksButton"
                                Content="Tasks &amp; Timer"
                                Style="{StaticResource GlassSecondaryButtonStyle}"
                                Click="OnShowTasksSubTabClick"
                                Padding="5,3.5"
                                Margin="1,0,1,0"
                                FontSize="10.5" />
                        <Button x:Name="SubNotesButton"
                                Content="Quick Notes"
                                Style="{StaticResource GlassSecondaryButtonStyle}"
                                Click="OnShowNotesSubTabClick"
                                Padding="5,3.5"
                                Margin="2,0,0,0"
                                FontSize="10.5" />
                    </UniformGrid>

                    <!-- M7.1: Quick Launcher View -->
                    <Grid x:Name="LauncherSubView" Grid.Row="1" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBox x:Name="LauncherSearchTextBox"
                                 Grid.Row="0"
                                 Style="{StaticResource GlassTextBoxStyle}"
                                 TextChanged="OnLauncherSearchTextChanged"
                                 PreviewKeyDown="OnLauncherSearchPreviewKeyDown"
                                 Margin="0,0,0,6" />

                        <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,0,0,6">
                            <Button Content="Open File..."
                                    Style="{StaticResource GlassSecondaryButtonStyle}"
                                    Click="OnLauncherOpenFileClick"
                                    Padding="8,3"
                                    Margin="0,0,4,0"
                                    FontSize="10" />
                            <Button Content="Open Folder..."
                                    Style="{StaticResource GlassSecondaryButtonStyle}"
                                    Click="OnLauncherOpenFolderClick"
                                    Padding="8,3"
                                    Margin="0,0,4,0"
                                    FontSize="10" />
                            <Button Content="Refresh"
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource GlassSecondaryButtonStyle}"
                                    Click="OnLauncherRefreshClick"
                                    Padding="7,3"
                                    FontSize="10" />
                        </DockPanel>

                        <TextBlock x:Name="LauncherStatusText"
                                   Grid.Row="2"
                                   Text="Type to filter apps, or press ↑/↓ and Enter to launch"
                                   Foreground="{DynamicResource GlassMutedTextBrush}"
                                   FontSize="10"
                                   Margin="0,0,0,5" />

                        <Border x:Name="LauncherEmptyState"
                                Grid.Row="3"
                                Background="{DynamicResource GlassLevel2FillBrush}"
                                BorderBrush="{DynamicResource GlassLevel2BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14"
                                Visibility="Collapsed">
                            <TextBlock x:Name="LauncherEmptyText"
                                       Text="No matching applications or recent items found."
                                       Foreground="{DynamicResource GlassMutedTextBrush}"
                                       FontSize="11"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                        </Border>

                        <ListBox x:Name="LauncherResultsListBox"
                                 Grid.Row="3"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 MouseDoubleClick="OnLauncherResultDoubleClick"
                                 PreviewKeyDown="OnLauncherListPreviewKeyDown">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,4" />
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource GlassLevel3CardFillBrush}"
                                            BorderBrush="{DynamicResource GlassLevel3CardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="8,6">
                                        <DockPanel LastChildFill="True">
                                            <Button Content="Open"
                                                    Tag="{Binding}"
                                                    DockPanel.Dock="Right"
                                                    Style="{StaticResource GlassPrimaryButtonStyle}"
                                                    Click="OnLaunchItemButtonClick"
                                                    Padding="8,2.5"
                                                    Margin="6,0,0,0"
                                                    FontSize="9.8"
                                                    VerticalAlignment="Center" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}"
                                                           Foreground="{DynamicResource GlassPrimaryTextBrush}"
                                                           FontWeight="SemiBold"
                                                           FontSize="11.2"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Category}"
                                                           Foreground="{DynamicResource GlassMutedTextBrush}"
                                                           FontSize="9.6"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- M7.2: Tasks, Countdown Timer & Reminders View -->
                    <ScrollViewer x:Name="TasksSubView"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="Collapsed">
                        <StackPanel>
                            <!-- Wall-Clock Countdown Timer Card -->
                            <Border Style="{StaticResource GlassSectionBorderStyle}" Margin="0,0,0,8">
                                <StackPanel>
                                    <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                        <TextBlock Text="Countdown Timer"
                                                   Foreground="{DynamicResource GlassAccentTextBrush}"
                                                   FontWeight="SemiBold"
                                                   FontSize="11.5"
                                                   VerticalAlignment="Center" />
                                        <TextBlock x:Name="TimerStateBadgeText"
                                                   Text="Idle"
                                                   DockPanel.Dock="Right"
                                                   Foreground="{DynamicResource GlassSecondaryTextBrush}"
                                                   FontSize="10.5"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>

                                    <TextBlock x:Name="TimerDisplayClockText"
                                               Text="25:00"
                                               Foreground="{DynamicResource GlassPrimaryTextBrush}"
                                               FontFamily="Consolas"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Margin="0,2,0,6" />

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="64" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TimerLabelTextBox"
                                                 Grid.Column="0"
                                                 Text="Focus Sprint"
                                                 Style="{StaticResource GlassTextBoxStyle}"
                                                 Margin="0,0,4,0" />
                                        <TextBox x:Name="TimerMinutesTextBox"
                                                 Grid.Column="1"
                                                 Text="25"
                                                 Style="{StaticResource GlassTextBoxStyle}"
                                                 ToolTip="Duration in minutes (or seconds if prefixed with 's', e.g. 10s)" />
                                    </Grid>

                                    <UniformGrid Columns="4">
                                        <Button x:Name="TimerStartButton"
                                                Content="Start"
                                                Style="{StaticResource GlassPrimaryButtonStyle}"
                                                Click="OnTimerStartClick"
                                                Padding="4,3"
                                                Margin="0,0,2,0"
                                                FontSize="10" />
                                        <Button x:Name="TimerPauseResumeButton"
                                                Content="Pause"
                                                Style="{StaticResource GlassSecondaryButtonStyle}"
                                                Click="OnTimerPauseResumeClick"
                                                Padding="4,3"
                                                Margin="1,0,1,0"
                                                FontSize="10" />
                                        <Button Content="Reset"
                                                Style="{StaticResource GlassSecondaryButtonStyle}"
                                                Click="OnTimerResetClick"
                                                Padding="4,3"
                                                Margin="1,0,1,0"
                                                FontSize="10" />
                                        <Button Content="Cancel"
                                                Style="{StaticResource GlassDangerButtonStyle}"
                                                Click="OnTimerCancelClick"
                                                Padding="4,3"
                                                Margin="2,0,0,0"
                                                FontSize="10" />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- Tasks & Reminders Card -->
                            <Border Style="{StaticResource GlassSectionBorderStyle}">
                                <StackPanel>
                                    <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                        <TextBlock Text="Tasks &amp; Reminders"
                                                   Foreground="{DynamicResource GlassAccentTextBrush}"
                                                   FontWeight="SemiBold"
                                                   FontSize="11.5"
                                                   VerticalAlignment="Center" />
                                        <ComboBox x:Name="TaskFilterComboBox"
                                                  DockPanel.Dock="Right"
                                                  Width="92"
                                                  SelectedIndex="0"
                                                  SelectionChanged="OnTaskFilterChanged"
                                                  FontSize="10">
                                            <ComboBoxItem Content="All Tasks" />
                                            <ComboBoxItem Content="Active" />
                                            <ComboBoxItem Content="Completed" />
                                        </ComboBox>
                                    </DockPanel>

                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="72" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="NewTaskTitleTextBox"
                                                 Grid.Column="0"
                                                 Style="{StaticResource GlassTextBoxStyle}"
                                                 KeyDown="OnNewTaskTitleKeyDown"
                                                 Margin="0,0,4,0" />
                                        <ComboBox x:Name="NewTaskPriorityComboBox"
                                                  Grid.Column="1"
                                                  SelectedIndex="1"
                                                  FontSize="10">
                                            <ComboBoxItem Content="Low" />
                                            <ComboBoxItem Content="Normal" />
                                            <ComboBoxItem Content="High" />
                                        </ComboBox>
                                    </Grid>

                                    <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                        <Button Content="+ Add Task"
                                                Style="{StaticResource GlassPrimaryButtonStyle}"
                                                Click="OnAddTaskClick"
                                                Padding="8,3"
                                                Margin="0,0,4,0"
                                                FontSize="10" />
                                        <Button Content="+ Remind in 10m"
                                                Style="{StaticResource GlassSecondaryButtonStyle}"
                                                Click="OnAddQuickReminderClick"
                                                Padding="8,3"
                                                FontSize="10" />
                                        <TextBlock x:Name="PendingRemindersBadgeText"
                                                   DockPanel.Dock="Right"
                                                   Text="0 reminders"
                                                   Foreground="{DynamicResource GlassMutedTextBrush}"
                                                   FontSize="9.8"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>

                                    <TextBlock x:Name="TasksEmptyText"
                                               Text="No tasks in this view. Add a task above!"
                                               Foreground="{DynamicResource GlassMutedTextBrush}"
                                               FontSize="10.5"
                                               Margin="0,4,0,4"
                                               Visibility="Collapsed" />

                                    <ItemsControl x:Name="TasksItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource GlassLevel3CardFillBrush}"
                                                        BorderBrush="{DynamicResource GlassLevel3CardBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="7"
                                                        Padding="7,5"
                                                        Margin="0,0,0,4">
                                                    <DockPanel LastChildFill="True">
                                                        <Button Content="✕"
                                                                Tag="{Binding Id}"
                                                                DockPanel.Dock="Right"
                                                                Style="{StaticResource GlassIconButtonStyle}"
                                                                Click="OnDeleteTaskClick"
                                                                Padding="5,1"
                                                                FontSize="10"
                                                                VerticalAlignment="Center" />
                                                        <CheckBox IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                                                  Tag="{Binding Id}"
                                                                  Style="{StaticResource GlassCheckBoxStyle}"
                                                                  Click="OnToggleTaskCompletedClick"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,0,6,0" />
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}"
                                                                       Foreground="{DynamicResource GlassPrimaryTextBrush}"
                                                                       FontSize="11"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding Priority}"
                                                                       Foreground="{DynamicResource GlassMutedTextBrush}"
                                                                       FontSize="9.2" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- M7.3: Quick Notes View -->
                    <Grid x:Name="NotesSubView" Grid.Row="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="115" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,6">
                            <Button Content="+ New"
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource GlassPrimaryButtonStyle}"
                                    Click="OnNewNoteClick"
                                    Padding="8,3"
                                    Margin="4,0,0,0"
                                    FontSize="10" />
                            <Button Content="Delete"
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource GlassDangerButtonStyle}"
                                    Click="OnDeleteNoteClick"
                                    Padding="7,3"
                                    Margin="4,0,0,0"
                                    FontSize="10" />
                            <TextBox x:Name="NotesSearchTextBox"
                                     Style="{StaticResource GlassTextBoxStyle}"
                                     TextChanged="OnNotesSearchTextChanged"
                                     ToolTip="Search notes by title or content" />
                        </DockPanel>

                        <ListBox x:Name="NotesListBox"
                                 Grid.Row="1"
                                 Background="{DynamicResource GlassLevel2FillBrush}"
                                 BorderBrush="{DynamicResource GlassLevel2BorderBrush}"
                                 BorderThickness="1"
                                 SelectionChanged="OnSelectedNoteChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Margin="0,0,0,6">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="True" Margin="2,2">
                                        <TextBlock Text="{Binding UpdatedAtUtc, StringFormat='{}{0:HH:mm}'}"
                                                   DockPanel.Dock="Right"
                                                   Foreground="{DynamicResource GlassMutedTextBrush}"
                                                   FontSize="9.5"
                                                   Margin="6,0,0,0" />
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="{DynamicResource GlassPrimaryTextBrush}"
                                                   FontSize="10.8"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Grid.Row="2"
                                Background="{DynamicResource GlassLevel2FillBrush}"
                                BorderBrush="{DynamicResource GlassLevel2BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBox x:Name="NoteTitleEditorTextBox"
                                         Grid.Row="0"
                                         Style="{StaticResource GlassTextBoxStyle}"
                                         FontWeight="SemiBold"
                                         TextChanged="OnNoteEditorTextChanged"
                                         Margin="0,0,0,5" />

                                <TextBox x:Name="NoteContentEditorTextBox"
                                         Grid.Row="1"
                                         Style="{StaticResource GlassTextBoxStyle}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         VerticalContentAlignment="Top"
                                         TextChanged="OnNoteEditorTextChanged" />

                                <TextBlock x:Name="NoteAutoSaveStatusText"
                                           Grid.Row="2"
                                           Text="Ready — notes auto-save locally to SQLite"
                                           Foreground="{DynamicResource GlassMutedTextBrush}"
                                           FontSize="9.5"
                                           Margin="0,4,0,0" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Row 2C: Companion & Dev Controls View (Milestone 1-3.1 Controls Preserved) -->
                <StackPanel x:Name="CompanionViewPanel" Grid.Row="2" Visibility="Collapsed">
                    <Border Style="{StaticResource GlassSectionBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Mascot Expressions"
                                       Foreground="{DynamicResource GlassAccentTextBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="11.5"
                                       Margin="0,0,0,7" />

                            <UniformGrid Columns="3" Rows="2">
                                <Button Content="Happy"
                                        Style="{StaticResource GlassSecondaryButtonStyle}"
                                        Click="OnHappyClick"
                                        Margin="0,0,4,4" />
                                <Button Content="Surprised"
                                        Style="{StaticResource GlassSecondaryButtonStyle}"
                                        Click="OnSurprisedClick"
                                        Margin="2,0,2,4" />
                                <Button Content="Curious"
                                        Style="{StaticResource GlassSecondaryButtonStyle}"
                                        Click="OnCuriousClick"
                                        Margin="4,0,0,4" />
                                <Button Content="Sleepy"
                                        Style="{StaticResource GlassSecondaryButtonStyle}"
                                        Click="OnSleepyClick"
                                        Margin="0,4,4,0" />
                                <Button Content="Annoyed"
                                        Style="{StaticResource GlassDangerButtonStyle}"
                                        Click="OnAnnoyedClick"
                                        Margin="2,4,2,0" />
                                <Button Content="Peekaboo"
                                        Style="{StaticResource GlassSecondaryButtonStyle}"
                                        Click="OnPeekabooClick"
                                        Margin="4,4,0,0" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Button Content="Dev: Trigger Autonomous Hop Now"
                            Style="{StaticResource GlassPrimaryButtonStyle}"
                            Click="OnDevAutonomousHopClick"
                            Padding="8,6.5"
                            Margin="0,0,0,8" />

                    <TextBlock x:Name="AckStatusText"
                               Text="Ready — click an expression or dev trigger above"
                               Foreground="{DynamicResource GlassAccentTextBrush}"
                               FontSize="11"
                               Margin="0,0,0,3" />

                    <TextBlock x:Name="SchedulerStatusText"
                               Text="Scheduler: Active"
                               Foreground="{DynamicResource GlassSecondaryTextBrush}"
                               FontSize="10.5"
                               Margin="0,0,0,4" />

                    <Border Background="{DynamicResource GlassLevel2FillBrush}"
                            BorderBrush="{DynamicResource GlassLevel2BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8,5"
                            Margin="0,0,0,6">
                        <TextBlock x:Name="AwarenessStatusText"
                                   Text="Context: Normal | Visibility: Visible | Movement: Permitted"
                                   Foreground="{DynamicResource GlassPrimaryTextBrush}"
                                   FontFamily="Consolas"
                                   FontSize="9.8"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Border Background="{DynamicResource GlassLevel3InputFillBrush}"
                            BorderBrush="{DynamicResource GlassLevel2BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Height="105"
                            Padding="7">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="DiagnosticsText"
                                       Text="Diagnostics log ready..."
                                       Foreground="{DynamicResource GlassMutedTextBrush}"
                                       FontFamily="Consolas"
                                       FontSize="10"
                                       TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
