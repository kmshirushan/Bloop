<Window x:Class="Bloop.Desktop.Windows.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bloop Companion Panel"
        Width="290"
        Height="265"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False">
    <Border CornerRadius="16"
            Background="#E60F172A"
            BorderBrush="#5538BDF8"
            BorderThickness="1.2"
            Padding="16"
             Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.45" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <DockPanel LastChildFill="False" Margin="0,0,0,10">
                <TextBlock Text="Bloop — Milestone 1 Demo"
                           Foreground="#F8FAFC"
                           FontWeight="SemiBold"
                           FontSize="14"
                           VerticalAlignment="Center" />
                <Button Content="✕"
                        DockPanel.Dock="Right"
                        Click="OnCloseClick"
                        Background="Transparent"
                        Foreground="#94A3B8"
                        BorderThickness="0"
                        FontSize="13"
                        Cursor="Hand"
                        Padding="6,2" />
            </DockPanel>

            <TextBlock Text="Test procedural expressions &amp; animations:"
                       Foreground="#94A3B8"
                       FontSize="12"
                       Margin="0,0,0,10" />

            <UniformGrid Columns="2" Rows="2" Margin="0,0,0,12">
                <Button Content="Happy Bounce"
                        Click="OnHappyClick"
                        Margin="0,0,6,6"
                        Padding="8,7"
                        Background="#1E293B"
                        Foreground="#38BDF8"
                        BorderBrush="#334155" />
                <Button Content="Surprised"
                        Click="OnSurprisedClick"
                        Margin="6,0,0,6"
                        Padding="8,7"
                        Background="#1E293B"
                        Foreground="#38BDF8"
                        BorderBrush="#334155" />
                <Button Content="Curious"
                        Click="OnCuriousClick"
                        Margin="0,6,6,0"
                        Padding="8,7"
                        Background="#1E293B"
                        Foreground="#38BDF8"
                        BorderBrush="#334155" />
                <Button Content="Sleepy"
                        Click="OnSleepyClick"
                        Margin="6,6,0,0"
                        Padding="8,7"
                        Background="#1E293B"
                        Foreground="#38BDF8"
                        BorderBrush="#334155" />
            </UniformGrid>

            <TextBlock x:Name="AckStatusText"
                       Text="Ready — click an expression above"
                       Foreground="#38BDF8"
                       FontSize="11"
                       Margin="0,0,0,6" />

            <TextBlock Text="Tip: Single-click Bloop to bounce, drag near any screen edge to dock, or double-click to toggle this panel."
                       Foreground="#64748B"
                       FontSize="11"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</Window>

