<Window x:Class="Bloop.Desktop.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bloop Settings"
        Width="390"
        Height="490"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0F172A"
        Foreground="#F8FAFC">
    <StackPanel Margin="20">
        <TextBlock Text="Bloop Companion Preferences"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="#38BDF8"
                   Margin="0,0,0,14" />

        <CheckBox x:Name="AlwaysOnTopCheckBox"
                  Content="Keep Bloop Always on Top"
                  Foreground="#E2E8F0"
                  IsChecked="True"
                  Checked="OnSettingChanged"
                  Unchecked="OnSettingChanged"
                  Margin="0,0,0,14" />

        <Separator Background="#334155" Margin="0,0,0,12" />

        <TextBlock Text="Movement &amp; Edge Docking"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="#7DD3FC"
                   Margin="0,0,0,10" />

        <CheckBox x:Name="EdgeDockingCheckBox"
                  Content="Enable Screen-Edge Peek Docking"
                  Foreground="#E2E8F0"
                  IsChecked="True"
                  Checked="OnSettingChanged"
                  Unchecked="OnSettingChanged"
                  Margin="0,0,0,8" />

        <CheckBox x:Name="AutonomousMovementCheckBox"
                  Content="Enable Autonomous Edge Hopping"
                  Foreground="#E2E8F0"
                  IsChecked="True"
                  Checked="OnSettingChanged"
                  Unchecked="OnSettingChanged"
                  Margin="0,0,0,14" />

        <DockPanel Margin="0,0,0,4">
            <TextBlock Text="Docked Visibility:" Foreground="#CBD5E1" />
            <TextBlock x:Name="VisibilityValueText"
                       Text="60%"
                       Foreground="#38BDF8"
                       HorizontalAlignment="Right"
                       DockPanel.Dock="Right" />
        </DockPanel>
        <Slider x:Name="DockedVisibilitySlider"
                Minimum="40"
                Maximum="85"
                Value="60"
                TickFrequency="5"
                IsSnapToTickEnabled="True"
                ValueChanged="OnSliderValueChanged"
                Margin="0,0,0,12" />

        <DockPanel Margin="0,0,0,4">
            <TextBlock Text="Autonomy Cooldown (min):" Foreground="#CBD5E1" />
            <TextBlock x:Name="FrequencyValueText"
                       Text="5.0 min"
                       Foreground="#38BDF8"
                       HorizontalAlignment="Right"
                       DockPanel.Dock="Right" />
        </DockPanel>
        <Slider x:Name="AutonomyCooldownSlider"
                Minimum="1"
                Maximum="15"
                Value="5"
                TickFrequency="1"
                IsSnapToTickEnabled="True"
                ValueChanged="OnSliderValueChanged"
                Margin="0,0,0,12" />

        <DockPanel Margin="0,0,0,4">
            <TextBlock Text="Movement Speed:" Foreground="#CBD5E1" />
            <TextBlock x:Name="SpeedValueText"
                       Text="1.0x"
                       Foreground="#38BDF8"
                       HorizontalAlignment="Right"
                       DockPanel.Dock="Right" />
        </DockPanel>
        <Slider x:Name="MovementSpeedSlider"
                Minimum="0.5"
                Maximum="2.0"
                Value="1.0"
                TickFrequency="0.1"
                IsSnapToTickEnabled="True"
                ValueChanged="OnSliderValueChanged"
                Margin="0,0,0,16" />

        <UniformGrid Columns="2" Margin="0,0,0,16">
            <Button Content="Restore Movement Defaults"
                    Click="OnRestoreDefaultsClick"
                    Margin="0,0,6,0"
                    Padding="8,7"
                    Background="#1E293B"
                    Foreground="#F8FAFC"
                    BorderBrush="#334155" />
            <Button Content="Reset Position"
                    Click="OnResetPositionClick"
                    Margin="6,0,0,0"
                    Padding="8,7"
                    Background="#1E293B"
                    Foreground="#F8FAFC"
                    BorderBrush="#334155" />
        </UniformGrid>

        <Button Content="Close"
                Click="OnCloseClick"
                HorizontalAlignment="Right"
                Width="88"
                Padding="8,6"
                Background="#0284C7"
                Foreground="White"
                BorderThickness="0" />
    </StackPanel>
</Window>
