<Window x:Class="Bloop.Desktop.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bloop — Companion, Appearance &amp; Behaviour Settings"
        Width="500"
        Height="780"
        MinWidth="450"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        Foreground="{DynamicResource GlassPrimaryTextBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="-1"
                      ResizeBorderThickness="6"
                      CaptionHeight="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- Level 1: Main Liquid Glass Window Surface -->
    <Border x:Name="OuterSettingsBorder"
            CornerRadius="{DynamicResource GlassWindowCornerRadius}"
            Background="{DynamicResource GlassLevel1FillBrush}"
            BorderBrush="{DynamicResource GlassLevel1RimBrush}"
            BorderThickness="1"
            ClipToBounds="True">
        <Grid>
            <!-- Top-left ambient glass refraction glow -->
            <Border Background="{DynamicResource GlassLevel1AmbientGlowBrush}"
                    IsHitTestVisible="False" />

            <!-- 1px top specular catch-light edge -->
            <Border Height="1"
                    VerticalAlignment="Top"
                    Margin="16,0,16,0"
                    Background="{DynamicResource GlassLevel1TopSpecularBrush}"
                    IsHitTestVisible="False" />

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: Custom Integrated Liquid Glass Title Bar -->
                <Border Grid.Row="0"
                        Background="#180F172A"
                        BorderBrush="{DynamicResource GlassLevel2BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,11"
                        MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown"
                        Cursor="SizeAll">
                    <DockPanel LastChildFill="False">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="9"
                                     Height="9"
                                     Fill="{DynamicResource GlassPrimaryAccentFillBrush}"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="Bloop Settings &amp; Appearance Studio"
                                       Foreground="{DynamicResource GlassPrimaryTextBrush}"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Border Background="{DynamicResource GlassLevel4FillBrush}"
                                    BorderBrush="{DynamicResource GlassLevel4BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="6,1.5"
                                    Margin="9,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="TitleBarProfileBadgeText"
                                           Text="Classic Blue"
                                           Foreground="{DynamicResource GlassAccentTextBrush}"
                                           FontSize="10"
                                           FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>

                        <Button Content="✕"
                                DockPanel.Dock="Right"
                                Style="{StaticResource GlassIconButtonStyle}"
                                Click="OnCloseClick"
                                ToolTip="Close Settings"
                                FontSize="12"
                                Padding="8,3" />
                        <Button x:Name="MaximizeRestoreButton"
                                Content="□"
                                DockPanel.Dock="Right"
                                Style="{StaticResource GlassIconButtonStyle}"
                                Click="OnMaximizeRestoreClick"
                                ToolTip="Maximize / Restore"
                                FontSize="12"
                                Padding="8,3"
                                Margin="0,0,2,0" />
                        <Button Content="—"
                                DockPanel.Dock="Right"
                                Style="{StaticResource GlassIconButtonStyle}"
                                Click="OnMinimizeClick"
                                ToolTip="Minimize"
                                FontSize="12"
                                Padding="8,3"
                                Margin="0,0,2,0" />
                    </DockPanel>
                </Border>

                <!-- Row 1: Scrollable Liquid Glass Sections -->
                <ScrollViewer x:Name="SettingsScrollViewer"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              Padding="16,14,16,8">
                    <StackPanel>

                        <!-- SECTION 1: APPEARANCE PROFILES -->
                        <Border Style="{StaticResource GlassSectionBorderStyle}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Appearance Profiles"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource GlassAccentTextBrush}" />
                                    <TextBlock x:Name="DwmStatusBadgeText"
                                               Text="Liquid Glass Active"
                                               FontSize="10"
                                               Foreground="{DynamicResource GlassMutedTextBrush}"
                                               HorizontalAlignment="Right"
                                               DockPanel.Dock="Right"
                                               VerticalAlignment="Center" />
                                </DockPanel>

                                <TextBlock Text="Active Profile:"
                                           Foreground="{DynamicResource GlassSecondaryTextBrush}"
                                           FontSize="11"
                                           Margin="0,0,0,4" />
                                <ComboBox x:Name="ProfileComboBox"
                                          Style="{StaticResource GlassComboBoxStyle}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="ProfileId"
                                          SelectionChanged="OnProfileSelectionChanged"
                                          Margin="0,0,0,8" />

                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Profile Name:"
                                               Foreground="{DynamicResource GlassSecondaryTextBrush}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                    <TextBox x:Name="ProfileNameTextBox"
                                             Style="{StaticResource GlassTextBoxStyle}" />
                                </DockPanel>

                                <UniformGrid Columns="5" Margin="0,0,0,8">
                                    <Button Content="New"
                                            Style="{StaticResource GlassPrimaryButtonStyle}"
                                            Click="OnCreateProfileClick"
                                            Margin="0,0,3,0"
                                            Padding="4,4.5"
                                            FontSize="11" />
                                    <Button Content="Duplicate"
                                            Style="{StaticResource GlassSecondaryButtonStyle}"
                                            Click="OnDuplicateProfileClick"
                                            Margin="2,0,2,0"
                                            Padding="4,4.5"
                                            FontSize="11" />
                                    <Button Content="Rename"
                                            Style="{StaticResource GlassSecondaryButtonStyle}"
                                            Click="OnRenameProfileClick"
                                            Margin="2,0,2,0"
                                            Padding="4,4.5"
                                            FontSize="11" />
                                    <Button Content="Reset"
                                            Style="{StaticResource GlassSecondaryButtonStyle}"
                                            Click="OnResetProfileClick"
                                            Margin="2,0,2,0"
                                            Padding="4,4.5"
                                            FontSize="11" />
                                    <Button Content="Delete"
                                            Style="{StaticResource GlassDangerButtonStyle}"
                                            Click="OnDeleteProfileClick"
                                            Margin="3,0,0,0"
                                            Padding="4,4.5"
                                            FontSize="11" />
                                </UniformGrid>

                                <UniformGrid Columns="3">
                                    <Button Content="Preview Live"
                                            Style="{StaticResource GlassSecondaryButtonStyle}"
                                            Click="OnPreviewAppearanceClick"
                                            Margin="0,0,4,0" />
                                    <Button Content="Apply &amp; Save"
                                            Style="{StaticResource GlassPrimaryButtonStyle}"
                                            Click="OnApplyAndSaveAppearanceClick"
                                            Margin="2,0,2,0" />
                                    <Button Content="Cancel Preview"
                                            Style="{StaticResource GlassSecondaryButtonStyle}"
                                            Click="OnCancelAppearancePreviewClick"
                                            Margin="4,0,0,0" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- SECTION 2: CHARACTER MATERIAL, COLOUR & SCALE -->
                        <Border Style="{StaticResource GlassSectionBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Character Material, Colour &amp; Scale"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource GlassAccentTextBrush}"
                                           Margin="0,0,0,8" />

                                <UniformGrid Columns="2" Margin="0,0,0,8">
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="Material Preset:" Foreground="{DynamicResource GlassSecondaryTextBrush}" FontSize="11" Margin="0,0,0,3" />
                                        <ComboBox x:Name="CharacterPresetComboBox"
                                                  Style="{StaticResource GlassComboBoxStyle}"
                                                  SelectionChanged="OnCharacterPresetChanged" />
                                    </StackPanel>
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Eye Style:" Foreground="{DynamicResource GlassSecondaryTextBrush}" FontSize="11" Margin="0,0,0,3" />
                                        <ComboBox x:Name="EyeStyleComboBox"
                                                  Style="{StaticResource GlassComboBoxStyle}"
                                                  SelectionChanged="OnAppearanceControlChanged" />
                                    </StackPanel>
                                </UniformGrid>

                                <UniformGrid Columns="2" Margin="0,0,0,8">
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="Body Colour (#RRGGBB):" Foreground="{DynamicResource GlassSecondaryTextBrush}" FontSize="11" Margin="0,0,0,3" />
                                        <TextBox x:Name="BodyColorTextBox"
                                                 Style="{StaticResource GlassTextBoxStyle}"
                                                 TextChanged="OnAppearanceTextChanged" />
                                    </StackPanel>
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Accent Colour (#RRGGBB):" Foreground="{DynamicResource GlassSecondaryTextBrush}" FontSize="11" Margin="0,0,0,3" />
                                        <TextBox x:Name="AccentColorTextBox"
                                                 Style="{StaticResource GlassTextBoxStyle}"
                                                 TextChanged="OnAppearanceTextChanged" />
                                    </StackPanel>
                                </UniformGrid>

                                <!-- Quick Glass Colour Swatches -->
                                <TextBlock Text="Quick Palette Swatches:" Foreground="{DynamicResource GlassMutedTextBrush}" FontSize="10.5" Margin="0,0,0,4" />
                                <UniformGrid Columns="6" Margin="0,0,0,10">
                                    <Button Content="Sapphire" Tag="#0284C7,#38BDF8" Style="{StaticResource GlassSecondaryButtonStyle}" Click="OnQuickSwatchClick" FontSize="10" Padding="3,3.5" Margin="0,0,2,0" />
                                    <Button Content="Emerald" Tag="#059669,#34D399" Style="{StaticResource GlassSecondaryButtonStyle}" Click="OnQuickSwatchClick" FontSize="10" Padding="3,3.5" Margin="2,0,2,0" />
                                    <Button Content="Amethyst" Tag="#7C3AED,#C4B5FD" Style="{StaticResource GlassSecondaryButtonStyle}" Click="OnQuickSwatchClick" FontSize="10" Padding="3,3.5" Margin="2,0,2,0" />
                                    <Button Content="Ruby" Tag="#E11D48,#FDA4AF" Style="{StaticResource GlassSecondaryButtonStyle}" Click="OnQuickSwatchClick" FontSize="10" Padding="3,3.5" Margin="2,0,2,0" />
                                    <Button Content="Amber" Tag="#D97706,#FDE047" Style="{StaticResource GlassSecondaryButtonStyle}" Click="OnQuickSwatchClick" FontSize="10" Padding="3,3.5" Margin="2,0,2,0" />
                                    <Button Content="Abyssal" Tag="#0B2545,#22D3EE" Style="{StaticResource GlassSecondaryButtonStyle}" Click="OnQuickSwatchClick" FontSize="10" Padding="3,3.5" Margin="2,0,0,0" />
                                </UniformGrid>

                                <DockPanel Margin="0,0,0,3">
                                    <TextBlock Text="Character Scale:" Foreground="{DynamicResource GlassSecondaryTextBrush}" FontSize="11.5" />
                                    <TextBlock x:Name="CharacterScaleValueText" Text="1.00x" Foreground="{DynamicResource GlassAccentTextBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" DockPanel.Dock="Right" />
                                </DockPanel>
                                <Slider x:Name="CharacterScaleSlider"
                                        Style="{StaticResource GlassSliderStyle}"
                                        Minimum="0.65"
                                        Maximum="1.50"
                                        Value="1.00"
                                        TickFrequency="0.05"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="OnAppearanceSliderChanged"
                                        Margin="0,0,0,8" />

                                <DockPanel Margin="0,0,0,3">
                                    <TextBlock Text="Surface Roughness:" Foreground="{DynamicResource GlassSecondaryTextBrush}" FontSize="11.5" />
                                    <TextBlock x:Name="RoughnessValueText" Text="0.14" Foreground="{DynamicResource GlassAccentTextBrush}" HorizontalAlignment="Right" DockPanel.Dock="Right" />
                                </DockPanel>
                                <Slider x:Name="RoughnessSlider"
                                        Style="{StaticResource GlassSliderStyle}"
                                        Minimum="0.00"
                                        Maximum="1.00"
                                        Value="0.14"
                                        TickFrequency="0.02"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="OnAppearanceSliderChanged"
                                        Margin="0,0,0,8" />

                                <DockPanel Margin="0,0,0,3">
                                    <TextBlock Text="Metalness:" Foreground="{DynamicResource GlassSecondaryTextBrush}" FontSize="11.5" />
                                    <TextBlock x:Name="MetalnessValueText" Text="0.04" Foreground="{DynamicResource GlassAccentTextBrush}" HorizontalAlignment="Right" DockPanel.Dock="Right" />
                                </DockPanel>
                                <Slider x:Name="MetalnessSlider"
                                        Style="{StaticResource GlassSliderStyle}"
                                        Minimum="0.00"
                                        Maximum="1.00"
                                        Value="0.04"
                                        TickFrequency="0.02"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="OnAppearanceSliderChanged"
                                        Margin="0,0,0,8" />

                                <DockPanel Margin="0,0,0,3">
                                    <TextBlock Text="Body Optical Opacity:" Foreground="{DynamicResource GlassSecondaryTextBrush}" FontSize="11.5" />
                                    <TextBlock x:Name="OpacityValueText" Text="1.00" Foreground="{DynamicResource GlassAccentTextBrush}" HorizontalAlignment="Right" DockPanel.Dock="Right" />
                                </DockPanel>
                                <Slider x:Name="OpacitySlider"
                                        Style="{StaticResource GlassSliderStyle}"
                                        Minimum="0.25"
                                        Maximum="1.00"
                                        Value="1.00"
                                        TickFrequency="0.05"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="OnAppearanceSliderChanged"
                                        Margin="0,0,0,8" />

                                <CheckBox x:Name="EnableGlowCheckBox"
                                          Style="{StaticResource GlassCheckBoxStyle}"
                                          Content="Enable Specular Rim / Internal Caustic Glow"
                                          Checked="OnAppearanceControlChanged"
                                          Unchecked="OnAppearanceControlChanged" />

                                <DockPanel Margin="0,0,0,3">
                                    <TextBlock Text="Glow Intensity:" Foreground="{DynamicResource GlassSecondaryTextBrush}" FontSize="11.5" />
                                    <TextBlock x:Name="GlowIntensityValueText" Text="0.35" Foreground="{DynamicResource GlassAccentTextBrush}" HorizontalAlignment="Right" DockPanel.Dock="Right" />
                                </DockPanel>
                                <Slider x:Name="GlowIntensitySlider"
                                        Style="{StaticResource GlassSliderStyle}"
                                        Minimum="0.00"
                                        Maximum="2.00"
                                        Value="0.35"
                                        TickFrequency="0.05"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="OnAppearanceSliderChanged" />
                            </StackPanel>
                        </Border>

                        <!-- SECTION 3: 3D CHARACTER ACCESSORIES -->
                        <Border Style="{StaticResource GlassSectionBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="3D Character Accessories"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource GlassAccentTextBrush}"
                                           Margin="0,0,0,8" />

                                <UniformGrid Columns="2" Margin="0,0,0,8">
                                    <CheckBox x:Name="AccWizardHatCheckBox" Style="{StaticResource GlassCheckBoxStyle}" Content="Wizard Hat (Head)" Tag="wizard_hat" Checked="OnAccessoryCheckChanged" Unchecked="OnAccessoryCheckChanged" />
                                    <CheckBox x:Name="AccCapCheckBox" Style="{StaticResource GlassCheckBoxStyle}" Content="Baseball Cap (Head)" Tag="cap" Checked="OnAccessoryCheckChanged" Unchecked="OnAccessoryCheckChanged" />
                                    <CheckBox x:Name="AccCrownCheckBox" Style="{StaticResource GlassCheckBoxStyle}" Content="Royal Crown (Head)" Tag="crown" Checked="OnAccessoryCheckChanged" Unchecked="OnAccessoryCheckChanged" />
                                    <CheckBox x:Name="AccHeadphonesCheckBox" Style="{StaticResource GlassCheckBoxStyle}" Content="Headphones (Head)" Tag="headphones" Checked="OnAccessoryCheckChanged" Unchecked="OnAccessoryCheckChanged" />
                                    <CheckBox x:Name="AccSunglassesCheckBox" Style="{StaticResource GlassCheckBoxStyle}" Content="Cool Shades (Face)" Tag="sunglasses" Checked="OnAccessoryCheckChanged" Unchecked="OnAccessoryCheckChanged" />
                                    <CheckBox x:Name="AccGlassesCheckBox" Style="{StaticResource GlassCheckBoxStyle}" Content="Reading Glasses (Face)" Tag="glasses" Checked="OnAccessoryCheckChanged" Unchecked="OnAccessoryCheckChanged" />
                                    <CheckBox x:Name="AccScarfCheckBox" Style="{StaticResource GlassCheckBoxStyle}" Content="Cozy Scarf (Front)" Tag="scarf" Checked="OnAccessoryCheckChanged" Unchecked="OnAccessoryCheckChanged" />
                                    <CheckBox x:Name="AccWingsCheckBox" Style="{StaticResource GlassCheckBoxStyle}" Content="Angel Wings (Back)" Tag="wings" Checked="OnAccessoryCheckChanged" Unchecked="OnAccessoryCheckChanged" />
                                </UniformGrid>

                                <DockPanel>
                                    <TextBlock Text="Accessory Tint (#RRGGBB):" Foreground="{DynamicResource GlassSecondaryTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox x:Name="AccessoryTintTextBox"
                                             Style="{StaticResource GlassTextBoxStyle}"
                                             TextChanged="OnAppearanceTextChanged" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- SECTION 4: NOTIFICATION PANEL THEME & GLASS SURFACE -->
                        <Border Style="{StaticResource GlassSectionBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Notification Panel &amp; Glass Surface"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource GlassAccentTextBrush}"
                                           Margin="0,0,0,8" />

                                <UniformGrid Columns="2" Margin="0,0,0,8">
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="Panel Theme:" Foreground="{DynamicResource GlassSecondaryTextBrush}" FontSize="11" Margin="0,0,0,3" />
                                        <ComboBox x:Name="PanelThemeComboBox"
                                                  Style="{StaticResource GlassComboBoxStyle}"
                                                  SelectionChanged="OnPanelThemePresetChanged" />
                                    </StackPanel>
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Card Density:" Foreground="{DynamicResource GlassSecondaryTextBrush}" FontSize="11" Margin="0,0,0,3" />
                                        <ComboBox x:Name="CardDensityComboBox"
                                                  Style="{StaticResource GlassComboBoxStyle}"
                                                  SelectionChanged="OnAppearanceControlChanged" />
                                    </StackPanel>
                                </UniformGrid>

                                <CheckBox x:Name="SyncPanelAccentCheckBox"
                                          Style="{StaticResource GlassCheckBoxStyle}"
                                          Content="Synchronize Panel Accent with Character Accent"
                                          IsChecked="True"
                                          Checked="OnAppearanceControlChanged"
                                          Unchecked="OnAppearanceControlChanged" />

                                <UniformGrid Columns="2" Margin="0,0,0,8">
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="Glass Tint (#RRGGBB):" Foreground="{DynamicResource GlassSecondaryTextBrush}" FontSize="11" Margin="0,0,0,3" />
                                        <TextBox x:Name="PanelBgColorTextBox"
                                                 Style="{StaticResource GlassTextBoxStyle}"
                                                 TextChanged="OnAppearanceTextChanged" />
                                    </StackPanel>
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Panel Accent (#RRGGBB):" Foreground="{DynamicResource GlassSecondaryTextBrush}" FontSize="11" Margin="0,0,0,3" />
                                        <TextBox x:Name="PanelAccentColorTextBox"
                                                 Style="{StaticResource GlassTextBoxStyle}"
                                                 TextChanged="OnAppearanceTextChanged" />
                                    </StackPanel>
                                </UniformGrid>

                                <DockPanel Margin="0,0,0,3">
                                    <TextBlock Text="Main Glass Opacity:" Foreground="{DynamicResource GlassSecondaryTextBrush}" FontSize="11.5" />
                                    <TextBlock x:Name="PanelBgOpacityValueText" Text="0.96" Foreground="{DynamicResource GlassAccentTextBrush}" HorizontalAlignment="Right" DockPanel.Dock="Right" />
                                </DockPanel>
                                <Slider x:Name="PanelBgOpacitySlider"
                                        Style="{StaticResource GlassSliderStyle}"
                                        Minimum="0.35"
                                        Maximum="1.00"
                                        Value="0.96"
                                        TickFrequency="0.05"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="OnAppearanceSliderChanged"
                                        Margin="0,0,0,8" />

                                <DockPanel Margin="0,0,0,3">
                                    <TextBlock Text="Notification Card Frosted Opacity:" Foreground="{DynamicResource GlassSecondaryTextBrush}" FontSize="11.5" />
                                    <TextBlock x:Name="PanelCardOpacityValueText" Text="0.92" Foreground="{DynamicResource GlassAccentTextBrush}" HorizontalAlignment="Right" DockPanel.Dock="Right" />
                                </DockPanel>
                                <Slider x:Name="PanelCardOpacitySlider"
                                        Style="{StaticResource GlassSliderStyle}"
                                        Minimum="0.35"
                                        Maximum="1.00"
                                        Value="0.92"
                                        TickFrequency="0.05"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="OnAppearanceSliderChanged"
                                        Margin="0,0,0,8" />

                                <DockPanel Margin="0,0,0,3">
                                    <TextBlock Text="Surface Corner Radius:" Foreground="{DynamicResource GlassSecondaryTextBrush}" FontSize="11.5" />
                                    <TextBlock x:Name="PanelCornerRadiusValueText" Text="16 px" Foreground="{DynamicResource GlassAccentTextBrush}" HorizontalAlignment="Right" DockPanel.Dock="Right" />
                                </DockPanel>
                                <Slider x:Name="PanelCornerRadiusSlider"
                                        Style="{StaticResource GlassSliderStyle}"
                                        Minimum="6"
                                        Maximum="28"
                                        Value="16"
                                        TickFrequency="2"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="OnAppearanceSliderChanged" />
                            </StackPanel>
                        </Border>

                        <!-- SECTION 4B: DESKTOP AWARENESS & CONTEXTUAL BEHAVIOUR (MILESTONE 6) -->
                        <Border Style="{StaticResource GlassSectionBorderStyle}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Desktop Awareness &amp; Focus Mode"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource GlassAccentTextBrush}" />
                                    <TextBlock x:Name="AwarenessLiveBadgeText"
                                               Text="Context: Normal"
                                               FontSize="10"
                                               Foreground="{DynamicResource GlassMutedTextBrush}"
                                               HorizontalAlignment="Right"
                                               DockPanel.Dock="Right"
                                               VerticalAlignment="Center" />
                                </DockPanel>

                                <TextBlock Text="Bloop uses window metadata and last-input idle time only — never screen capture, OCR, or keystroke logging."
                                           Foreground="{DynamicResource GlassMutedTextBrush}"
                                           FontSize="10.8"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8" />

                                <CheckBox x:Name="DesktopAwarenessEnabledCheckBox"
                                          Style="{StaticResource GlassCheckBoxStyle}"
                                          Content="Enable Desktop Awareness Engine"
                                          FontWeight="SemiBold"
                                          IsChecked="True"
                                          Checked="OnSettingChanged"
                                          Unchecked="OnSettingChanged" />

                                <CheckBox x:Name="FullScreenDetectionCheckBox"
                                          Style="{StaticResource GlassCheckBoxStyle}"
                                          Content="Enable Full-Screen Application Detection"
                                          IsChecked="True"
                                          Checked="OnSettingChanged"
                                          Unchecked="OnSettingChanged" />

                                <CheckBox x:Name="AutoHideFullScreenCheckBox"
                                          Style="{StaticResource GlassCheckBoxStyle}"
                                          Content="Automatically Hide Bloop completely during Full-Screen Apps"
                                          IsChecked="True"
                                          Checked="OnSettingChanged"
                                          Unchecked="OnSettingChanged" />

                                <CheckBox x:Name="CatchUpAfterFullScreenCheckBox"
                                          Style="{StaticResource GlassCheckBoxStyle}"
                                          Content="Play Single Catch-Up Glance After Full-Screen Ends"
                                          IsChecked="True"
                                          Checked="OnSettingChanged"
                                          Unchecked="OnSettingChanged" />

                                <CheckBox x:Name="ManualFocusModeCheckBox"
                                          Style="{StaticResource GlassCheckBoxStyle}"
                                          Content="Manual Focus Mode (Remain Subtly Present &amp; Quiet)"
                                          FontWeight="SemiBold"
                                          IsChecked="False"
                                          Checked="OnSettingChanged"
                                          Unchecked="OnSettingChanged" />

                                <CheckBox x:Name="AutoFocusInferenceCheckBox"
                                          Style="{StaticResource GlassCheckBoxStyle}"
                                          Content="Enable Conservative Automatic Focus Inference"
                                          IsChecked="True"
                                          Checked="OnSettingChanged"
                                          Unchecked="OnSettingChanged" />

                                <CheckBox x:Name="SuppressRandomClickInFocusCheckBox"
                                          Style="{StaticResource GlassCheckBoxStyle}"
                                          Content="Suppress Random Click Variations During Focus"
                                          IsChecked="False"
                                          Checked="OnSettingChanged"
                                          Unchecked="OnSettingChanged" />

                                <CheckBox x:Name="InactivityDetectionCheckBox"
                                          Style="{StaticResource GlassCheckBoxStyle}"
                                          Content="Enable User Inactivity Detection (Active / Quiet / Away / Sleep)"
                                          IsChecked="True"
                                          Checked="OnSettingChanged"
                                          Unchecked="OnSettingChanged" />

                                <CheckBox x:Name="AutoQuietModeCheckBox"
                                          Style="{StaticResource GlassCheckBoxStyle}"
                                          Content="Enable Automatic Quiet Mode Before Away/Sleep"
                                          IsChecked="True"
                                          Checked="OnSettingChanged"
                                          Unchecked="OnSettingChanged" />

                                <CheckBox x:Name="SessionPowerAwarenessCheckBox"
                                          Style="{StaticResource GlassCheckBoxStyle}"
                                          Content="Hide &amp; Suspend on Windows Session Lock / System Sleep"
                                          IsChecked="True"
                                          Checked="OnSettingChanged"
                                          Unchecked="OnSettingChanged"
                                          Margin="0,0,0,8" />

                                <DockPanel Margin="0,0,0,3">
                                    <TextBlock Text="Full-Screen Restore Delay:" Foreground="{DynamicResource GlassSecondaryTextBrush}" FontSize="11.5" />
                                    <TextBlock x:Name="FullScreenRestoreDelayValueText" Text="700 ms" Foreground="{DynamicResource GlassAccentTextBrush}" HorizontalAlignment="Right" DockPanel.Dock="Right" />
                                </DockPanel>
                                <Slider x:Name="FullScreenRestoreDelaySlider"
                                        Style="{StaticResource GlassSliderStyle}"
                                        Minimum="200"
                                        Maximum="3000"
                                        Value="700"
                                        TickFrequency="100"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="OnSliderValueChanged"
                                        Margin="0,0,0,8" />

                                <DockPanel Margin="0,0,0,3">
                                    <TextBlock Text="Quiet Threshold (sec):" Foreground="{DynamicResource GlassSecondaryTextBrush}" FontSize="11.5" />
                                    <TextBlock x:Name="QuietThresholdValueText" Text="60 s" Foreground="{DynamicResource GlassAccentTextBrush}" HorizontalAlignment="Right" DockPanel.Dock="Right" />
                                </DockPanel>
                                <Slider x:Name="QuietThresholdSlider"
                                        Style="{StaticResource GlassSliderStyle}"
                                        Minimum="15"
                                        Maximum="300"
                                        Value="60"
                                        TickFrequency="15"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="OnSliderValueChanged"
                                        Margin="0,0,0,8" />

                                <DockPanel Margin="0,0,0,3">
                                    <TextBlock Text="Away Threshold (sec):" Foreground="{DynamicResource GlassSecondaryTextBrush}" FontSize="11.5" />
                                    <TextBlock x:Name="AwayThresholdValueText" Text="300 s" Foreground="{DynamicResource GlassAccentTextBrush}" HorizontalAlignment="Right" DockPanel.Dock="Right" />
                                </DockPanel>
                                <Slider x:Name="AwayThresholdSlider"
                                        Style="{StaticResource GlassSliderStyle}"
                                        Minimum="60"
                                        Maximum="900"
                                        Value="300"
                                        TickFrequency="30"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="OnSliderValueChanged"
                                        Margin="0,0,0,8" />

                                <TextBlock Text="Full-Screen Excluded Processes (comma-separated, e.g. obs64, discord):"
                                           Foreground="{DynamicResource GlassSecondaryTextBrush}"
                                           FontSize="11"
                                           Margin="0,0,0,3" />
                                <TextBox x:Name="FullScreenExclusionsTextBox"
                                         Style="{StaticResource GlassTextBoxStyle}"
                                         TextChanged="OnTextSettingChanged"
                                         Margin="0,0,0,8" />

                                <TextBlock Text="Application Awareness Rules (e.g. code=Focus, spotify=Normal, vlc=Excluded):"
                                           Foreground="{DynamicResource GlassSecondaryTextBrush}"
                                           FontSize="11"
                                           Margin="0,0,0,3" />
                                <TextBox x:Name="AwarenessAppRulesTextBox"
                                         Style="{StaticResource GlassTextBoxStyle}"
                                         TextChanged="OnTextSettingChanged"
                                         Margin="0,0,0,8" />

                                <UniformGrid Columns="3">
                                    <Button Content="Wake Now"
                                            Style="{StaticResource GlassSecondaryButtonStyle}"
                                            Click="OnForceWakeClick"
                                            Margin="0,0,3,0"
                                            FontSize="11" />
                                    <Button Content="Sleep Now"
                                            Style="{StaticResource GlassSecondaryButtonStyle}"
                                            Click="OnForceSleepClick"
                                            Margin="2,0,2,0"
                                            FontSize="11" />
                                    <Button Content="Auto Presence"
                                            Style="{StaticResource GlassPrimaryButtonStyle}"
                                            Click="OnAutoIdleClick"
                                            Margin="3,0,0,0"
                                            FontSize="11" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- SECTION 5: WINDOWS NOTIFICATION INBOX & PRIVACY -->
                        <Border Style="{StaticResource GlassSectionBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Windows Notification Inbox &amp; Privacy"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource GlassAccentTextBrush}"
                                           Margin="0,0,0,4" />

                                <TextBlock Text="Notification integration is opt-in. Titles and messages are stored only on your device and are never logged or transmitted."
                                           Foreground="{DynamicResource GlassMutedTextBrush}"
                                           FontSize="10.8"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8" />

                                <CheckBox x:Name="AlwaysOnTopCheckBox"
                                          Style="{StaticResource GlassCheckBoxStyle}"
                                          Content="Keep Bloop Mascot Always on Top"
                                          IsChecked="True"
                                          Checked="OnSettingChanged"
                                          Unchecked="OnSettingChanged" />

                                <CheckBox x:Name="NotificationIntegrationCheckBox"
                                          Style="{StaticResource GlassCheckBoxStyle}"
                                          Content="Enable Windows Notification Inbox Integration (Opt-In)"
                                          FontWeight="SemiBold"
                                          IsChecked="False"
                                          Checked="OnNotificationIntegrationToggled"
                                          Unchecked="OnNotificationIntegrationToggled" />

                                <CheckBox x:Name="StoreLocalHistoryCheckBox"
                                          Style="{StaticResource GlassCheckBoxStyle}"
                                          Content="Persist Notification History in Local SQLite Database"
                                          IsChecked="True"
                                          Checked="OnSettingChanged"
                                          Unchecked="OnSettingChanged" />

                                <CheckBox x:Name="NotificationReactionsCheckBox"
                                          Style="{StaticResource GlassCheckBoxStyle}"
                                          Content="Enable Mascot Reactions for New Notifications"
                                          IsChecked="True"
                                          Checked="OnSettingChanged"
                                          Unchecked="OnSettingChanged" />

                                <CheckBox x:Name="HighImportanceEntranceCheckBox"
                                          Style="{StaticResource GlassCheckBoxStyle}"
                                          Content="Enable Center-Screen Entrance for High/Critical Alerts"
                                          IsChecked="True"
                                          Checked="OnSettingChanged"
                                          Unchecked="OnSettingChanged"
                                          Margin="0,0,0,8" />

                                <TextBlock Text="High-Priority Keywords (comma-separated, optional):"
                                           Foreground="{DynamicResource GlassSecondaryTextBrush}"
                                           FontSize="11"
                                           Margin="0,0,0,3" />
                                <TextBox x:Name="HighPriorityKeywordsTextBox"
                                         Style="{StaticResource GlassTextBoxStyle}"
                                         TextChanged="OnTextSettingChanged"
                                         Margin="0,0,0,8" />

                                <TextBlock Text="App Priority Rules (e.g. Outlook=High, Promotions=Muted):"
                                           Foreground="{DynamicResource GlassSecondaryTextBrush}"
                                           FontSize="11"
                                           Margin="0,0,0,3" />
                                <TextBox x:Name="AppPriorityRulesTextBox"
                                         Style="{StaticResource GlassTextBoxStyle}"
                                         TextChanged="OnTextSettingChanged"
                                         Margin="0,0,0,8" />

                                <Button Content="Clear Local Notification History"
                                        Style="{StaticResource GlassDangerButtonStyle}"
                                        Click="OnClearHistoryClick"
                                        HorizontalAlignment="Left"
                                        Padding="10,5" />
                            </StackPanel>
                        </Border>

                        <!-- SECTION 6: AUTONOMOUS & INTERACTIVE BEHAVIOURS -->
                        <Border Style="{StaticResource GlassSectionBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Autonomous &amp; Interactive Behaviours"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource GlassAccentTextBrush}"
                                           Margin="0,0,0,8" />

                                <CheckBox x:Name="GlobalPauseCheckBox"
                                          Style="{StaticResource GlassCheckBoxStyle}"
                                          Content="Global Pause (Suspend All Autonomous Behaviours)"
                                          FontWeight="SemiBold"
                                          IsChecked="False"
                                          Checked="OnSettingChanged"
                                          Unchecked="OnSettingChanged" />

                                <CheckBox x:Name="EdgeDockingCheckBox"
                                          Style="{StaticResource GlassCheckBoxStyle}"
                                          Content="Enable Screen-Edge Peek Docking"
                                          IsChecked="True"
                                          Checked="OnSettingChanged"
                                          Unchecked="OnSettingChanged" />

                                <CheckBox x:Name="AutonomousMovementCheckBox"
                                          Style="{StaticResource GlassCheckBoxStyle}"
                                          Content="Enable Autonomous Edge Hopping"
                                          IsChecked="True"
                                          Checked="OnSettingChanged"
                                          Unchecked="OnSettingChanged" />

                                <CheckBox x:Name="CornerExplorationCheckBox"
                                          Style="{StaticResource GlassCheckBoxStyle}"
                                          Content="Enable Screen-Corner Exploration"
                                          IsChecked="True"
                                          Checked="OnSettingChanged"
                                          Unchecked="OnSettingChanged" />

                                <CheckBox x:Name="WindowExplorationCheckBox"
                                          Style="{StaticResource GlassCheckBoxStyle}"
                                          Content="Enable Foreground Window-Boundary Exploration"
                                          IsChecked="True"
                                          Checked="OnSettingChanged"
                                          Unchecked="OnSettingChanged" />

                                <CheckBox x:Name="PeekabooCheckBox"
                                          Style="{StaticResource GlassCheckBoxStyle}"
                                          Content="Enable Docked Peekaboo Behaviour"
                                          IsChecked="True"
                                          Checked="OnSettingChanged"
                                          Unchecked="OnSettingChanged" />

                                <CheckBox x:Name="EdgeBalancingCheckBox"
                                          Style="{StaticResource GlassCheckBoxStyle}"
                                          Content="Enable Docked Edge-Balancing Wobble"
                                          IsChecked="True"
                                          Checked="OnSettingChanged"
                                          Unchecked="OnSettingChanged" />

                                <CheckBox x:Name="CursorChasingCheckBox"
                                          Style="{StaticResource GlassCheckBoxStyle}"
                                          Content="Enable Playful Cursor Chasing"
                                          IsChecked="True"
                                          Checked="OnSettingChanged"
                                          Unchecked="OnSettingChanged" />

                                <CheckBox x:Name="AttentionSeekingCheckBox"
                                          Style="{StaticResource GlassCheckBoxStyle}"
                                          Content="Enable Idle Attention Seeking"
                                          IsChecked="True"
                                          Checked="OnSettingChanged"
                                          Unchecked="OnSettingChanged" />

                                <CheckBox x:Name="SleepModeCheckBox"
                                          Style="{StaticResource GlassCheckBoxStyle}"
                                          Content="Enable Inactivity Sleep Mode"
                                          IsChecked="True"
                                          Checked="OnSettingChanged"
                                          Unchecked="OnSettingChanged" />

                                <CheckBox x:Name="WelcomeBackCheckBox"
                                          Style="{StaticResource GlassCheckBoxStyle}"
                                          Content="Enable Welcome-Back Wake Reaction"
                                          IsChecked="True"
                                          Checked="OnSettingChanged"
                                          Unchecked="OnSettingChanged" />

                                <CheckBox x:Name="RandomClickCheckBox"
                                          Style="{StaticResource GlassCheckBoxStyle}"
                                          Content="Enable Weighted Random Click Reactions"
                                          IsChecked="True"
                                          Checked="OnSettingChanged"
                                          Unchecked="OnSettingChanged" />

                                <CheckBox x:Name="RepeatedClickAnnoyanceCheckBox"
                                          Style="{StaticResource GlassCheckBoxStyle}"
                                          Content="Enable Progressive Repeated-Click Annoyance"
                                          IsChecked="True"
                                          Checked="OnSettingChanged"
                                          Unchecked="OnSettingChanged"
                                          Margin="0" />
                            </StackPanel>
                        </Border>

                        <!-- SECTION 7: MOVEMENT & ANNOYANCE TUNING -->
                        <Border Style="{StaticResource GlassSectionBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="Movement &amp; Annoyance Tuning"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource GlassAccentTextBrush}"
                                           Margin="0,0,0,8" />

                                <DockPanel Margin="0,0,0,3">
                                    <TextBlock Text="Docked Visibility:" Foreground="{DynamicResource GlassSecondaryTextBrush}" FontSize="11.5" />
                                    <TextBlock x:Name="VisibilityValueText"
                                               Text="60%"
                                               Foreground="{DynamicResource GlassAccentTextBrush}"
                                               HorizontalAlignment="Right"
                                               DockPanel.Dock="Right" />
                                </DockPanel>
                                <Slider x:Name="DockedVisibilitySlider"
                                        Style="{StaticResource GlassSliderStyle}"
                                        Minimum="40"
                                        Maximum="85"
                                        Value="60"
                                        TickFrequency="5"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="OnSliderValueChanged"
                                        Margin="0,0,0,8" />

                                <DockPanel Margin="0,0,0,3">
                                    <TextBlock Text="Autonomy Cooldown (min):" Foreground="{DynamicResource GlassSecondaryTextBrush}" FontSize="11.5" />
                                    <TextBlock x:Name="FrequencyValueText"
                                               Text="5.0 min"
                                               Foreground="{DynamicResource GlassAccentTextBrush}"
                                               HorizontalAlignment="Right"
                                               DockPanel.Dock="Right" />
                                </DockPanel>
                                <Slider x:Name="AutonomyCooldownSlider"
                                        Style="{StaticResource GlassSliderStyle}"
                                        Minimum="1"
                                        Maximum="15"
                                        Value="5"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="OnSliderValueChanged"
                                        Margin="0,0,0,8" />

                                <DockPanel Margin="0,0,0,3">
                                    <TextBlock Text="Movement Speed:" Foreground="{DynamicResource GlassSecondaryTextBrush}" FontSize="11.5" />
                                    <TextBlock x:Name="SpeedValueText"
                                               Text="1.0x"
                                               Foreground="{DynamicResource GlassAccentTextBrush}"
                                               HorizontalAlignment="Right"
                                               DockPanel.Dock="Right" />
                                </DockPanel>
                                <Slider x:Name="MovementSpeedSlider"
                                        Style="{StaticResource GlassSliderStyle}"
                                        Minimum="0.5"
                                        Maximum="2.0"
                                        Value="1.0"
                                        TickFrequency="0.1"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="OnSliderValueChanged"
                                        Margin="0,0,0,8" />

                                <DockPanel Margin="0,0,0,3">
                                    <TextBlock Text="Annoyance Click Threshold:" Foreground="{DynamicResource GlassSecondaryTextBrush}" FontSize="11.5" />
                                    <TextBlock x:Name="AnnoyanceThresholdValueText"
                                               Text="5 clicks"
                                               Foreground="{DynamicResource GlassAccentTextBrush}"
                                               HorizontalAlignment="Right"
                                               DockPanel.Dock="Right" />
                                </DockPanel>
                                <Slider x:Name="AnnoyanceThresholdSlider"
                                        Style="{StaticResource GlassSliderStyle}"
                                        Minimum="3"
                                        Maximum="10"
                                        Value="5"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        ValueChanged="OnSliderValueChanged" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Row 2: Bottom Action Bar -->
                <Border Grid.Row="2"
                        Background="#180F172A"
                        BorderBrush="{DynamicResource GlassLevel2BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="16,10">
                    <DockPanel LastChildFill="False">
                        <Button Content="Restore All Defaults"
                                Style="{StaticResource GlassSecondaryButtonStyle}"
                                Click="OnRestoreDefaultsClick"
                                Margin="0,0,6,0" />
                        <Button Content="Reset Mascot Position"
                                Style="{StaticResource GlassSecondaryButtonStyle}"
                                Click="OnResetPositionClick" />
                        <Button Content="Done"
                                DockPanel.Dock="Right"
                                Style="{StaticResource GlassPrimaryButtonStyle}"
                                Click="OnCloseClick"
                                Width="88" />
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
